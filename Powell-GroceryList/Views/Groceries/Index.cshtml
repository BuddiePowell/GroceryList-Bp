@model List<Powell_GroceryList.Models.GroceryItem>
<html>
@{
    Layout = "_Layout";
    ViewBag.Title = "Groceries";
}
    <body>
        <h3>Groceries!</h3>
        <div class="container">
            <div class="row">
    @foreach (var groceryItem in @Model)
    {
        <div class="col-sm-3">@groceryItem.Name from @groceryItem.StoreId</div>
    }
        </div>
    </div>
    </body>
</html>
