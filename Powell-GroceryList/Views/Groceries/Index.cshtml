@model List<Powell_GroceryList.Models.GroceryItem>
<html>
    <head>
        <title> Grocery list</title>
        <link href="~/lib/bootstrap/dist/css/bootstap.css" rel="stylesheet" />
    </head>
    <body>
        <h3>Groceries!</h3>
        <div class="container">
            <div class="row">
    @foreach (var groceryItem in @Model)
    {
        <h4>@groceryItem.Name from @groceryItem.Store</h4>
    }
        </div>
    </div>
    </body>
</html>
