@model List<Powell_GroceryList.Models.Store>
<html>
   @{
        Layout = "_Layout";
        ViewBag.Title = "Stores";
}
    <body>
        <h3> Stores</h3>
        <div class="container">
            <div class="row">
                @foreach (var store in @Model)
            {
                <div class="col-sm-3">
                    <p>@store.Name</p>
                    <p>@store.Address</p>
                    <p>@store.City, @store.State</p>
                    <p>@store.PhoneNumber</p>
                </div>
            }
        </div>
        </div>
    </body>
</html>
