@model Powell_GroceryList.Models.GroceryItem
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewBag.Title = "Add Grocery item";
}

<div class="container">
    <div class="row">
        <div class="col-sm-6">

            <form method="post" action="Create">

                <div class="form-group">
                    <label asp-for="Name">Item Name</label>
                    <input asp-for="Name" class="form-control"/>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Store">Store Name</label>
                    <select asp-for="Store.Id" class="form-control">
                    @foreach(var store in ViewBag.AvailableStores)
                    {
                        <option value="@store.Id">@store.Name</option>
                    }
                    </select>

                </div>

                <button type="submit" class="btn btn-info">Add Item</button>
            </form>

        </div>
    </div>
</div>